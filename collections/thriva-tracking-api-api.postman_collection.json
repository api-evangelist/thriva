          "name": "List Tracking Events for a tracking code",
          "request": {
            "name": "List Tracking Events for a tracking code",
            "description": {
              "content": "Returns the tracking history for a tracking code, in ascending chronological order by `occurred_at`. Covers two journeys - outbound kit delivery and inbound sample return (see the `tracking_code` parameter and `status` for detail). Returns an empty collection if no events are available, including when the feature is not yet enabled for your organisation.",
              "type": "text/plain"
            },
